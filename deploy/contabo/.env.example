# Contabo Compose configuration. Copy to .env at the repo root on the server
# and replace every placeholder. Keep the file readable only by the
# deployment user (chmod 600 .env).
#
# docker-compose.contabo.yml injects LISTEN_PORT, HTTP_PORT, DB_HOST, DB_PORT,
# DB_NAME, DB_TLS_DISABLED, MIGRATION_PATH, RUN_MIGRATIONS, and the
# CLIENTS_GRPC_ADDR/TRANSACTIONS_GRPC_ADDR pair directly per service, so they
# are not listed here. Everything below is read from this file by Postgres,
# the migration jobs, and both app containers via env_file.

LOG_LEVEL=info

# Loopback host ports for docker-compose.contabo.hostnginx.yml. Each
# environment on the same VPS needs its own set; they must match the
# proxy_pass ports in deploy/contabo/nginx-host-site.<env>.conf.
#   testing:    8080 / 8081 / 3002
#   production: 8090 / 8091 / 3003
CLIENTS_HOST_PORT=8080
TRANSACTIONS_HOST_PORT=8081
ADMINDASHBOARD_HOST_PORT=3002

# Shared Postgres admin role. The postgres-init script creates one logical
# database per service ("clients", "transactions") owned by this role —
# this mirrors the "database-per-service, shared instance" model the AWS
# RDS setup used, just without a separate per-service Secrets Manager entry.
DB_USER=rvpay
DB_PASSWORD=replace-with-a-url-safe-database-password

# Clients: HighLevel OAuth provider
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
# Publicly reachable callback URL for the deployed Clients service,
# e.g. https://api.your-domain.com/oauth/callback
# (clients/config reads HIGHLEVEL_REDIRECT_URL, not ..._URI)
HIGHLEVEL_REDIRECT_URL=

# Clients: HighLevel webhook verification (PUBLIC key material, safe to commit
# upstream, but kept here for parity with clients/.env.example). Must stay
# double-quoted: Compose env files only accept multi-line values when quoted.
HIGHLEVEL_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=
-----END PUBLIC KEY-----"

# Clients: GHL Custom Payment Provider configuration
HIGHLEVEL_PAYMENT_URL=
HIGHLEVEL_QUERY_URL=
HIGHLEVEL_PROVIDER_NAME=RVPay
HIGHLEVEL_PROVIDER_DESCRIPTION=RVPay payment provider
HIGHLEVEL_PROVIDER_IMAGE_URL=
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
# Publicly reachable base URL of the deployed Clients service, e.g.
# https://api.your-domain.com
PUBLIC_BASE_URL=
HIGHLEVEL_LIVE_API_KEY=
HIGHLEVEL_LIVE_PUBLISHABLE_KEY=
HIGHLEVEL_TEST_API_KEY=
HIGHLEVEL_TEST_PUBLISHABLE_KEY=

# Transactions: PawaPay V2 integration
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_KEY=

# Transactions: HighLevel Inbound Webhook URL. Optional — when missing or not
# a valid HTTPS URL the delivery worker runs safely disabled.
HIGHLEVEL_INBOUND_WEBHOOK_URL=

# Browser origins allowed to call the HTTP gateways cross-origin (admin
# dashboard). Override if the dashboard is served from a different host than
# the upstream default (https://admindashboard.rvpay.xyz).
HTTP_CORS_ALLOWED_ORIGINS=https://admindashboard.rvpay.xyz

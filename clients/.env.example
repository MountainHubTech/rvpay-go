# Environment variables for Clients service
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=info

# gRPC server
LISTEN_PORT=50051

# HTTP gateway
PORT=8080

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clients
DB_TLS_DISABLED=true

# Migrations
RUN_MIGRATIONS=true
MIGRATION_PATH=db/migrations

# HighLevel OAuth provider
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
# Must be the publicly reachable callback URL of the deployed Clients service,
# e.g. https://<render-client-host>/oauth/callback
HIGHLEVEL_REDIRECT_URI=

# HighLevel webhook verification
# PEM-encoded Ed25519 public key used to verify X-GHL-Signature webhook
# signatures. This is PUBLIC cryptographic material, not a private secret.
HIGHLEVEL_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=
-----END PUBLIC KEY-----

# GHL Custom Payment Provider configuration
# The frontend checkout URL supplied to HighLevel as the payment provider's
# paymentsUrl. This is configuration, never hard-coded.
HIGHLEVEL_PAYMENT_URL=
# The backend query URL supplied to HighLevel as the payment provider's
# queryUrl. This is configuration, never hard-coded.
HIGHLEVEL_QUERY_URL=
# The display name of the payment provider.
HIGHLEVEL_PROVIDER_NAME=RVPay
# The description of the payment provider.
HIGHLEVEL_PROVIDER_DESCRIPTION=RVPay payment provider
# The image URL of the payment provider.
HIGHLEVEL_PROVIDER_IMAGE_URL=
# The HighLevel API base URL used for outbound Custom Payment Provider calls.
# This is configuration, never hard-coded.
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
# The publicly reachable base URL of the deployed backend. Used to derive the
# backend query URL for the payment provider configuration. This is
# configuration, never hard-coded.
PUBLIC_BASE_URL=

# Transactions service gRPC address used by the GHL Custom Payment Provider
# query/webhook endpoints to correlate HighLevel transactions with RVPay
# deposits. This is the deployed Transactions service gRPC endpoint.
TRANSACTIONS_GRPC_ADDR=localhost:50052

# HighLevel Custom Payment Provider live/test processing keys pushed to GHL
# via POST /payments/custom-provider/connect during provider registration.
HIGHLEVEL_LIVE_API_KEY=replace-with-rvpay-live-api-key
HIGHLEVEL_LIVE_PUBLISHABLE_KEY=replace-with-rvpay-live-publishable-key
HIGHLEVEL_TEST_API_KEY=replace-with-rvpay-test-api-key
HIGHLEVEL_TEST_PUBLISHABLE_KEY=replace-with-rvpay-test-publishable-key
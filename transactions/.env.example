# Environment variables for Transactions service
# Copy this file to .env and fill in your values

LOG_LEVEL=info
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=transactions
DB_TLS_DISABLED=true
RUN_MIGRATIONS=true
MIGRATION_PATH=db/migrations
LISTEN_PORT=50052

# PawaPay V2 integration
PAWAPAY_API_URL=
PAWAPAY_API_KEY=

# HTTP gateway
PORT=8081

# Migrations
RUN_MIGRATIONS=true
MIGRATION_PATH=db/migrations
# OCI Compose configuration. Copy to .env on the server and replace every placeholder.
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_KEY=replace-with-pawapay-api-key
LOG_LEVEL=info
LISTEN_PORT=50051
DB_USER=rvpay
DB_PASSWORD=replace-with-a-url-safe-database-password
DB_NAME=rvpay
MIGRATION_PATH=/app/deposits/db/migrations

# HighLevel Custom Payment Provider live/test processing keys pushed to GHL
# via POST /payments/custom-provider/connect during provider registration.
HIGHLEVEL_LIVE_API_KEY=replace-with-rvpay-live-api-key
HIGHLEVEL_LIVE_PUBLISHABLE_KEY=replace-with-rvpay-live-publishable-key
HIGHLEVEL_TEST_API_KEY=replace-with-rvpay-test-api-key
HIGHLEVEL_TEST_PUBLISHABLE_KEY=replace-with-rvpay-test-publishable-key

# --- Minimal admin authentication (Clients service) ---
# Administrators are DATABASE-MANAGED USERS (no env-configured admin).
# Provision the initial admin directly in the DB; generate the Argon2id hash with:
#   go run ./clients/cmd/hash-password < password.txt
# Opaque token lifetimes (Go durations). Default 1h access / 30d refresh.
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
# --- Transactions -> Clients internal gRPC (access-token validation) ---
CLIENTS_GRPC_ADDR=clients:50051
